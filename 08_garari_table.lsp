;; GARARITABLE / Windows AutoCAD 2021+ / Excel / UTF-8, LISPSYS=1 or 2
(vl-load-com)
(setq garari:version "2026-10-30.5")
(setq garari:directory
  (cond
    ((and (boundp '*load-truename*) *load-truename*) (vl-filename-directory *load-truename*))
    ((and (boundp '*load-pathname*) *load-pathname*) (vl-filename-directory *load-pathname*))
    ((findfile "08_garari_table.lsp") (vl-filename-directory (findfile "08_garari_table.lsp")))
    ((and (boundp 'pa-path) pa-path (findfile (strcat pa-path "08_garari_table.lsp"))) pa-path)))
(setq garari:config '((fd-temp . "72") (mesh-spec . "10") (sound . "なし")
  (order . natural) (widths 8 28 28 48) (floor-width . 7) (note-width . 24)
  (page-height . 680) (show-result . T) (table-sheet . "機器表（ガラリ）")))
(setq garari:tags '("GARARI" "DIA" "FD" "SHAPE" "MATERIAL" "MESH" "ROOM" "FLOOR" "SOUND"))
(setq garari:keys '("SHAPE" "DIA" "FD" "MATERIAL" "MESH" "MESH_SPEC" "FD_TEMP" "SOUND"))
(defun garari:get (a k) (if (assoc k a) (cdr (assoc k a)) ""))
(defun garari:set (a k v) (if (assoc k a) (subst (cons k v) (assoc k a) a) (cons (cons k v) a)))
(defun garari:trim (s) (vl-string-trim " \t\r\n　" (if s s "")))
(defun garari:half (s) (vl-string-translate
  "０１２３４５６７８９ＡＢＣＤＥＦＧＨＩＪＫＬＭＮＯＰＱＲＳＴＵＶＷＸＹＺａｂｃｄｅｆｇｈｉｊｋｌｍｎｏｐｑｒｓｔｕｖｗｘｙｚ"
  "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz" (garari:trim s)))
(defun garari:digits (s / ok c) (setq ok (/= s ""))
  (foreach c (vl-string->list s) (if (or (< c 48) (> c 57)) (setq ok nil))) ok)
(defun garari:dia (s / x)
  (setq x (strcase (garari:half s)))
  (if (member (substr x 1 1) '("φ" "Φ")) (setq x (substr x 2)))
  (cond ((and (>= (strlen x) 2) (= (substr x (1- (strlen x))) "MM")) (setq x (substr x 1 (- (strlen x) 2))))
        ((and (> (strlen x) 0) (member (substr x (strlen x)) '("φ" "Φ"))) (setq x (substr x 1 (1- (strlen x))))))
  (if (and (garari:digits x) (> (atoi x) 0) (< (strlen x) 9)) (itoa (atoi x)) ""))
(defun garari:bool (s / x) (setq x (strcase (garari:half s)))
  (cond ((member x '("あり" "有" "有り" "YES" "Y" "1")) "あり")
        ((member x '("なし" "無" "無し" "NO" "N" "0")) "なし") (T "")))
(defun garari:normalize (raw cfg / out tag s)
  (foreach tag garari:tags
    (setq s (garari:trim (garari:get raw tag)))
    (setq s (cond ((= tag "DIA") (garari:dia s))
      ((member tag '("FD" "MESH")) (garari:bool s))
      ((= tag "SOUND") (if (assoc tag raw) (garari:bool s) (cdr (assoc 'sound cfg))))
      ((= tag "SHAPE") (cond ((member s '("深形" "深型")) "深型") ((member s '("平形" "平型")) "平型") (T "")))
      ((= tag "MATERIAL") (if (member (strcase s) '("SUS" "SUS304" "ステンレス")) "SUS" (strcase s)))
      ((= tag "ROOM") (cond ((/= (garari:bool s) "") (garari:bool s)) (T (strcase (garari:half s)))))
      ((= tag "FLOOR") (garari:floor-name s))
      (T s)))
    (setq out (append out (list (cons tag s)))))
  (append out (list (cons "FD_TEMP" (if (= (garari:get out "FD") "あり") (cdr (assoc 'fd-temp cfg)) ""))
    (cons "MESH_SPEC" (if (= (garari:get out "MESH") "あり") (cdr (assoc 'mesh-spec cfg)) "")))))
(defun garari:issue (severity field message)
  (setq garari:issues (append garari:issues (list (list severity field message)))))
(defun garari:validate (raw norm / tag)
  (foreach tag '("GARARI" "DIA" "FD" "SHAPE" "MATERIAL" "MESH" "ROOM")
    (if (not (assoc tag raw)) (garari:issue "エラー" tag "必要タグ欠落")
      (if (= (garari:trim (garari:get raw tag)) "") (garari:issue "エラー" tag "未入力"))))
  (foreach tag '("DIA" "FD" "SHAPE" "MESH" "SOUND")
    (if (= (garari:get norm tag) "") (garari:issue "エラー" tag "不正値・非対応仕様")))
  (if (vl-string-search "\n" (garari:get norm "GARARI")) (garari:issue "エラー" "GARARI" "記号に改行")))
(defun garari:join (xs sep / s x) (setq s "")
  (foreach x xs (setq s (if (= s "") x (strcat s sep x)))) s)
(defun garari:fail (s) (setq garari:reason s) (exit))

;; Strict single-line RFC4180 fields. Embedded newlines are deliberately rejected.
(defun garari:csv-line (s / i c state field fields)
  (setq i 1 state 'start field "")
  (while (<= i (strlen s))
    (setq c (substr s i 1))
    (cond
      ((eq state 'quoted)
        (if (= c "\"")
          (if (= (substr s (1+ i) 1) "\"") (setq field (strcat field "\"") i (1+ i)) (setq state 'closed))
          (setq field (strcat field c))))
      ((= c ",") (setq fields (cons field fields) field "" state 'start))
      ((eq state 'closed) (garari:fail "CSV：閉じ引用符の後に不正文字"))
      ((= c "\"") (if (eq state 'start) (setq state 'quoted) (garari:fail "CSV：引用符の位置が不正")))
      (T (setq field (strcat field c) state 'plain)))
    (setq i (1+ i)))
  (if (eq state 'quoted) (garari:fail "CSV：引用符未完了／セル内改行は禁止"))
  (reverse (cons field fields)))
(defun garari:master-key (row) (mapcar '(lambda (k) (garari:get row k)) garari:keys))
;; Read the saved workbook in a private Excel instance. Never save the master.
(defun garari:master-path ()
  (if (null garari:directory) (garari:fail "LISPのフォルダを特定できません。main.LSPを再読込みしてください。"))
  (strcat (vl-string-right-trim "/\\" garari:directory) "/機器マスター_空調.xlsx"))
(defun garari:master-value (value)
  (if (= (type value) 'VARIANT) (setq value (vlax-variant-value value)))
  (cond ((null value) "") ((= (type value) 'STR) (garari:trim value))
    ((numberp value) (vlax-variant-value (vlax-variant-change-type (vlax-make-variant value) vlax-vbString)))
    (T (garari:fail "マスターセルの値を文字列へ変換できません。"))))
(defun garari:load-master-matrix (path sheet / books sheets ws used rows cols lastrow lastcol area result)
  (if (not (findfile path)) (garari:fail (strcat "機器マスターが存在しません：" path)))
  (if (null garari:excel)
    (progn
      (garari:progress "マスター用Excel起動")
      (setq garari:excel (garari:own (vlax-create-object "Excel.Application")))
      (garari:progress "マスター用Excel設定")
      (vlax-put-property garari:excel 'Visible :vlax-false)
      (vlax-put-property garari:excel 'DisplayAlerts :vlax-false)
      (vlax-put-property garari:excel 'EnableEvents :vlax-false)
      (vlax-put-property garari:excel 'AutomationSecurity 3)
      (garari:progress "マスター一時コピーを開く")
      (setq books (garari:own (vlax-get-property garari:excel 'Workbooks))
            garari:book (garari:own (vlax-invoke-method books 'Open path 0 :vlax-true 5 "" "" :vlax-true 2 "" :vlax-false :vlax-false)))))
  (garari:progress (strcat "マスター読取：" sheet))
  (setq sheets (garari:own (vlax-get-property garari:book 'Worksheets))
        ws (vl-catch-all-apply 'vlax-get-property (list sheets 'Item sheet)))
  (if (vl-catch-all-error-p ws) (garari:fail (strcat "マスターシートが存在しません：" sheet "\n対象Excel：" path)))
  (setq ws (garari:own ws) used (garari:own (vlax-get-property ws 'UsedRange))
        rows (garari:own (vlax-get-property used 'Rows)) cols (garari:own (vlax-get-property used 'Columns))
        lastrow (+ (vlax-get-property used 'Row) (vlax-get-property rows 'Count) -1)
        lastcol (+ (vlax-get-property used 'Column) (vlax-get-property cols 'Count) -1)
        area (garari:range ws 1 1 (max 3 lastrow) lastcol)
        result (garari:unwrap (vlax-get-property area 'Value2)))
  (if (/= (type result) 'SAFEARRAY) (garari:fail "マスターの読込み結果が配列ではありません。"))
  (vlax-safearray->list result))
(defun garari:master-matrix (path sheet / garari:excel garari:book garari:objects garari:handed garari:temp garari:file result)
  ;; Local ownership isolates master reading from output workbook ownership.
  (setq result (vl-catch-all-apply 'garari:load-master-snapshot (list path sheet)))
  (garari:cleanup)
  (if (vl-catch-all-error-p result)
    (garari:fail (if garari:reason garari:reason (strcat "マスター読込失敗：" (vl-catch-all-error-message result)))))
  result)
(defun garari:load-master-matrices (path)
  (list (garari:load-master-matrix path "GARARI_MASTER")
        (garari:load-master-matrix path "ROOM_MASTER")))
(defun garari:master-matrices (path / garari:excel garari:book garari:objects garari:handed garari:temp garari:file result)
  (setq result (vl-catch-all-apply 'garari:load-master-snapshots (list path)))
  (garari:cleanup)
  (if (vl-catch-all-error-p result)
    (garari:fail (if garari:reason garari:reason (strcat "マスター読込失敗：" (vl-catch-all-error-message result)))))
  result)
(defun garari:master-snapshot (path)
  (if (not (findfile path)) (garari:fail (strcat "機器マスターが存在しません：" path)))
  (setq garari:temp (vl-filename-mktemp "garari-master-" nil ".xlsx"))
  (if (findfile garari:temp) (vl-file-delete garari:temp))
  (if (or (not (vl-file-copy path garari:temp)) (/= (vl-file-size path) (vl-file-size garari:temp)))
    (garari:fail "機器マスターの一時コピーに失敗しました。")) garari:temp)
(defun garari:load-master-snapshot (path sheet)
  (garari:load-master-matrix (garari:master-snapshot path) sheet))
(defun garari:load-master-snapshots (path)
  (garari:load-master-matrices (garari:master-snapshot path)))
(defun garari:matrix-rows (matrix kind path / headers fields rows row required k seen key n)
  (if (null matrix) (garari:fail "空のマスター"))
  (setq headers (mapcar '(lambda (v) (strcase (garari:master-value v))) (car matrix))
    required (if (= kind "outdoor")
      (append garari:keys '("MANUFACTURER" "MODEL" "SPEC_NOTE" "APPROVED" "SOURCE_URL" "CHECKED_DATE"))
      '("MODEL" "MANUFACTURER" "DIA" "SPEC_NOTE" "APPROVED" "SOURCE_URL" "CHECKED_DATE" "AUTO_SELECT")))
  (foreach k required (if (not (member k headers)) (garari:fail (strcat "マスター必須列欠落：" k))))
  (foreach k headers (if (and (/= k "") (member k seen)) (garari:fail (strcat "マスター列重複：" k))) (setq seen (cons k seen)))
  (setq seen nil n 2)
  (foreach fields (cddr matrix)
    (setq n (1+ n))
    (setq fields (mapcar 'garari:master-value fields)
          row (mapcar 'cons headers fields))
    (if (/= (garari:get row "MODEL") "")
      (progn
        (if (/= (length fields) (length headers)) (garari:fail (strcat "マスター列数不一致：" (itoa n))))
        (if (not (member (garari:get row "APPROVED") '("0" "1"))) (garari:fail "APPROVEDは0または1"))
        (if (or (= (garari:get row "MODEL") "") (= (garari:dia (garari:get row "DIA")) "")) (garari:fail "マスター品番／径が不正"))
        (if (= kind "outdoor")
          (progn
            (foreach k '("FD" "MESH" "SOUND") (if (not (member (garari:get row k) '("あり" "なし"))) (garari:fail (strcat "マスター正規値不正：" k))))
            (if (not (member (garari:get row "SHAPE") '("深型" "平型"))) (garari:fail "マスターSHAPE不正"))
            (if (or (= (garari:get row "MATERIAL") "")
              (and (= (garari:get row "FD") "なし") (/= (garari:get row "FD_TEMP") ""))
              (and (= (garari:get row "FD") "あり") (not (garari:digits (garari:get row "FD_TEMP"))))
              (and (= (garari:get row "MESH") "なし") (/= (garari:get row "MESH_SPEC") ""))
              (and (= (garari:get row "MESH") "あり") (not (garari:digits (garari:get row "MESH_SPEC"))))) (garari:fail "マスター材質／温度／網目不正"))
            (setq key (garari:master-key row)))
          (progn
            (if (not (member (garari:get row "AUTO_SELECT") '("0" "1"))) (garari:fail "AUTO_SELECTは0または1"))
            (setq key (garari:get row "MODEL"))))
        (if (member key seen) (garari:issue "エラー" "MASTER" (strcat "マスターキー重複：" path " 行" (itoa n))))
        (setq seen (cons key seen) rows (cons row rows)))))
  (if (null rows) (garari:fail "3行目以降に有効な機器データがありません。"))
  (reverse rows))
(defun garari:read-master (path kind / sheet)
  (setq sheet (cond ((= kind "outdoor") "GARARI_MASTER") ((= kind "room") "ROOM_MASTER")
    (T (garari:fail (strcat "不明なマスター種別：" kind)))))
  (garari:matrix-rows (garari:master-matrix path sheet) kind (strcat path " / " sheet)))
(defun garari:read-masters (path / matrices)
  (setq matrices (garari:master-matrices path))
  (list (garari:matrix-rows (car matrices) "outdoor" (strcat path " / GARARI_MASTER"))
        (garari:matrix-rows (cadr matrices) "room" (strcat path " / ROOM_MASTER"))))

;; CAD extraction: editable and constant attributes, including invisible values.
(defun garari:unwrap (x) (while (= (type x) 'VARIANT) (setq x (vlax-variant-value x))) x)
(defun garari:array (x / r) (setq x (garari:unwrap x))
  (if (= (type x) 'SAFEARRAY)
    (progn (setq r (vl-catch-all-apply 'vlax-safearray->list (list x))) (if (not (vl-catch-all-error-p r)) r))
    (if (listp x) x)))
(defun garari:read-attrs (obj / method result attr tag out)
  (foreach method '(GetAttributes GetConstantAttributes)
    (setq result (vl-catch-all-apply 'vlax-invoke-method (list obj method)))
    (if (vl-catch-all-error-p result) (garari:issue "エラー" "ATTRIBUTES" (vl-catch-all-error-message result))
      (foreach attr (garari:array result)
        (setq tag (strcase (vla-get-TagString attr)))
        (if (assoc tag out) (garari:issue "エラー" tag "属性タグ重複"))
        (setq out (append out (list (cons tag (vla-get-TextString attr)))))
        (vlax-release-object attr)))) out)
(defun garari:name (o / r) (setq r (vl-catch-all-apply 'vlax-get-property (list o 'EffectiveName)))
  (if (vl-catch-all-error-p r) (vla-get-Name o) r))
(defun garari:target (e / d o yes block)
  (setq d (entget e))
  (if (and (= (cdr (assoc 0 d)) "INSERT") (= (cdr (assoc 410 d)) "Model")
    (<= (if (assoc 70 d) (cdr (assoc 70 d)) 1) 1)
    (<= (if (assoc 71 d) (cdr (assoc 71 d)) 1) 1))
    (progn (setq o (vlax-ename->vla-object e))
      (setq block (tblsearch "BLOCK" (vla-get-Name o)))
      (setq yes (and (= (strcase (garari:name o)) "GARARI")
        (= 0 (logand 4 (if (assoc 70 block) (cdr (assoc 70 block)) 0)))
        (not (= (vla-get-ObjectName o) "AcDbMInsertBlock"))))
      (vlax-release-object o))) yes)
(defun garari:select-model (norm master / found row)
  (foreach row master (if (and (= (garari:get row "APPROVED") "1") (equal (garari:master-key norm) (garari:master-key row)))
    (setq found (cons row found))))
  (cond ((= (length found) 1) (car found))
    ((null found) (garari:issue "警告" "MODEL" (strcat "選定未登録：" (garari:join (garari:master-key norm) "/"))) nil)
    (T (garari:issue "エラー" "MODEL" "承認済みマスター競合") nil)))
(defun garari:record (raw trace master rooms cfg / garari:issues norm outdoor indoor found room row)
  (setq garari:issues (garari:get trace "ISSUES") norm (garari:normalize raw cfg))
  (garari:validate raw norm)
  (if (/= (garari:get norm "FLOOR") "")
    (progn
      (if (and (/= (garari:get trace "SELECT_FLOOR") "") (/= (garari:get trace "SELECT_FLOOR") (garari:get norm "FLOOR"))) (garari:issue "警告" "FLOOR" "選択階とFLOOR属性が異なる（属性を優先）"))
      (setq trace (garari:set trace "FLOOR" (garari:get norm "FLOOR")))))
  (if (= (garari:get trace "FLOOR") "") (progn (setq trace (garari:set trace "FLOOR" "階未設定")) (garari:issue "警告" "FLOOR" "階未設定")))
  (setq outdoor (garari:select-model norm master) room (garari:get norm "ROOM"))
  (cond
    ((= room "あり")
      (foreach row rooms
        (if (and (= (garari:get row "MANUFACTURER") "三菱電機")
          (= (garari:get row "DIA") (garari:get norm "DIA"))
          (= (garari:get row "APPROVED") "1") (= (garari:get row "AUTO_SELECT") "1"))
          (setq found (cons row found))))
      (cond ((= (length found) 1) (setq indoor (car found)))
        ((null found) (garari:issue "警告" "ROOM" "室内給気口：要選定"))
        (T (garari:issue "エラー" "ROOM" "室内給気口：既定マスター競合"))))
    ((not (member room '("" "なし")))
      (garari:issue "警告" "ROOM" "旧ROOM品番形式：新規入力はあり／なし")
      (foreach row rooms (if (= (strcase (garari:half (garari:get row "MODEL"))) room) (setq found (cons row found))))
      (cond ((> (length found) 1) (garari:issue "エラー" "ROOM" "室内マスター競合"))
        ((or (null found) (/= (garari:get (car found) "APPROVED") "1")) (garari:issue "警告" "ROOM" "室内給気口仕様・適用径要確認"))
        ((/= (garari:get (car found) "DIA") (garari:get norm "DIA")) (garari:issue "エラー" "ROOM" "室内給気口の適用径不一致"))
        (T (setq indoor (car found))))))
  (if (not (member room '("" "なし"))) (garari:issue "警告" "ROOM" "セットの組合せ・施工適合要確認"))
  (append (list (cons "RAW" raw) (cons "NORM" norm) (cons "OUTDOOR" outdoor) (cons "INDOOR" indoor)
    (cons "ISSUES" garari:issues)) (vl-remove-if '(lambda (x) (= (car x) "ISSUES")) trace)))
(defun garari:add-record-issue (r level field message)
  (garari:set r "ISSUES" (append (garari:get r "ISSUES") (list (list level field message)))))
(defun garari:extract (e floor master rooms cfg / o raw trace garari:issues point r)
  (setq o (vlax-ename->vla-object e) raw (garari:read-attrs o) point (garari:array (vla-get-InsertionPoint o)))
  (setq trace (list (cons "DWG" (strcat (getvar "DWGPREFIX") (getvar "DWGNAME")))
    (cons "HANDLE" (vla-get-Handle o)) (cons "NAME" (garari:name o)) (cons "LAYER" (vla-get-Layer o))
    (cons "POINT" point) (cons "SELECT_FLOOR" floor) (cons "FLOOR" floor) (cons "ISSUES" garari:issues)))
  (vlax-release-object o) (garari:record raw trace master rooms cfg))
(defun garari:signature (r / n) (setq n (garari:get r "NORM"))
  (mapcar '(lambda (k) (garari:get n k)) (append '("DIA" "FD" "SHAPE" "MATERIAL" "MESH" "ROOM") '("MESH_SPEC" "FD_TEMP" "SOUND"))))
(defun garari:symbol (r / s) (setq s (garari:get (garari:get r "NORM") "GARARI"))
  (if (or (= s "") (vl-string-search "\n" s)) (strcat "未設定@" (garari:get r "HANDLE")) s))
(defun garari:cross-check (records / out r other conflict duplicate)
  (foreach r records
    (setq conflict nil duplicate nil)
    (foreach other records
      (if (/= (garari:get r "HANDLE") (garari:get other "HANDLE"))
        (progn
          (if (and (= (garari:symbol r) (garari:symbol other)) (not (equal (garari:signature r) (garari:signature other)))) (setq conflict T))
          (if (equal (garari:get r "POINT") (garari:get other "POINT") 1e-8) (setq duplicate T)))))
    (if conflict (setq r (garari:add-record-issue r "警告" "GARARI" "同一記号の仕様不一致")))
    (if duplicate (setq r (garari:add-record-issue r "警告" "POINT" "同一座標の重複候補（数量を保持）")))
    (setq out (append out (list r)))) out)
(defun garari:less (a b / x y dx dy)
  (setq x (car a) y (car b) dx (garari:digits x) dy (garari:digits y))
  (cond ((and dx dy) (if (= (atof x) (atof y)) (< x y) (< (atof x) (atof y))))
    (dx T) (dy nil)
    ((and (wcmatch x "[a-zA-Z]*") (not (wcmatch y "[a-zA-Z]*"))) T)
    ((and (wcmatch y "[a-zA-Z]*") (not (wcmatch x "[a-zA-Z]*"))) nil)
    (T (< x y))))
(defun garari:stable-sort (items predicate / indexed i item)
  (setq i 0)
  (foreach item items (setq indexed (append indexed (list (cons i item))) i (1+ i)))
  (mapcar 'cdr (vl-sort indexed '(lambda (a b)
    (cond ((apply predicate (list (cdr a) (cdr b))) T)
      ((apply predicate (list (cdr b) (cdr a))) nil) (T (< (car a) (car b))))))))
(defun garari:aggregate (records / groups key pair r)
  (foreach r records
    (setq key (cons (garari:symbol r) (garari:signature r)) pair (assoc key groups))
    (if pair (setq groups (subst (cons key (append (cdr pair) (list r))) pair groups))
      (setq groups (append groups (list (cons key (list r)))))))
  (if (eq (cdr (assoc 'order garari:config)) 'input) groups
    ;; sort indices preserves rows with identical symbols and different specifications
    (garari:stable-sort groups '(lambda (a b) (garari:less (car a) (car b))))))
(defun garari:floor-rank (s / x) (setq x (strcase s))
  (cond ((and (> (strlen x) 2) (= (substr x 1 1) "B") (= (substr x (strlen x)) "F") (garari:digits (substr x 2 (- (strlen x) 2)))) (- (atoi (substr x 2))))
    ((and (> (strlen x) 1) (= (substr x (strlen x)) "F") (garari:digits (substr x 1 (1- (strlen x))))) (atoi x))
