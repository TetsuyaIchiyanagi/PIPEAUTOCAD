    ((and (> (strlen x) 1) (= (substr x (strlen x)) "F") (garari:digits (substr x 1 (1- (strlen x))))) (strcat (itoa (atoi x)) "F"))
    ((and (> (strlen x) 2) (= (substr x 1 1) "B") (= (substr x (strlen x)) "F") (garari:digits (substr x 2 (- (strlen x) 2)))) (strcat "B" (itoa (atoi (substr x 2))) "F"))
