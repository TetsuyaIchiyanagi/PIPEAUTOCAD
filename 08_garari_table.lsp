(defun garari:split (s sep / pos out)
  (while (setq pos (vl-string-search sep s))
    (setq out (append out (list (substr s 1 pos))) s (substr s (+ pos 2))))
  (append out (list s)))
(defun garari:parse-floors (s / x parts part pair a b n out valid f)
  (setq x (garari:compact s) valid T)
  (setq x (vl-string-translate "，、～〜－–—" ",,-----" x))
  (foreach part (garari:split x ",")
    (cond
      ((vl-string-search "-" part)
        (setq pair (garari:split part "-"))
        (if (= (length pair) 2)
          (progn
            (setq a (garari:floor-name (car pair)) b (garari:floor-name (cadr pair)))
            (if (and (wcmatch a "#*F") (wcmatch b "#*F")
              (garari:digits (substr a 1 (1- (strlen a)))) (garari:digits (substr b 1 (1- (strlen b))))
              (> (atoi a) 0) (>= (atoi b) (atoi a)) (<= (atoi b) 999))
              (progn (setq n (atoi a)) (while (<= n (atoi b))
                (setq f (strcat (itoa n) "F")) (if (not (member f out)) (setq out (append out (list f)))) (setq n (1+ n))))
              (setq valid nil)))
          (setq valid nil)))
      ((= part "") (setq valid nil))
      (T (setq f (garari:floor-name part))
        (if (or (= f "RF")
          (and (= (substr f (strlen f)) "F")
            (setq a (if (= (substr f 1 1) "B") (substr f 2 (- (strlen f) 2)) (substr f 1 (1- (strlen f)))))
            (garari:digits a) (> (atoi a) 0) (<= (atoi a) 999)))
          (if (not (member f out)) (setq out (append out (list f))))
          (setq valid nil)))))
  (if valid out))
(defun garari:room-model (r / room indoor)
  (setq room (garari:get (garari:get r "NORM") "ROOM") indoor (garari:get r "INDOOR"))
  (cond (indoor (garari:get indoor "MODEL")) ((= room "あり") "要選定")
    ((member room '("なし" "")) "") (T room)))
(defun garari:selection (floor master rooms cfg records seen requested / retry ss i e h pair r count excluded value)
  (setq retry T excluded 0)
  (while retry
    (setq count 0)
    (princ (if (= floor "") "\n複数階の図面をまとめて選択（FLOOR属性で割当）：" (strcat "\n" floor " の範囲を選択：")))
    (setq ss (ssget))
    (if ss (progn (setq i 0) (repeat (sslength ss)
      (setq e (ssname ss i) i (1+ i))
      (if (garari:target e)
        (progn
          (setq count (1+ count) h (cdr (assoc 5 (entget e))) pair (assoc h seen))
          (if pair
            (if (/= (cdr pair) floor)
              (progn (setq r (car (vl-remove-if-not '(lambda (x) (= (garari:get x "HANDLE") h)) records)))
                (setq records (subst (garari:add-record-issue r "エラー" "FLOOR" "別階で再選択：階割当競合（最初の割当を保持）") r records))))
            (progn
              (setq r (garari:extract e floor master rooms cfg))
              (if (not (member (garari:get r "FLOOR") requested))
                (setq r (garari:add-record-issue r "警告" "FLOOR" "FLOOR未設定または指定外：追跡・追加階列へ保持")))
              (setq records (append records (list r)) seen (cons (cons h floor) seen)))))
        (setq excluded (1+ excluded))))))
    (princ (strcat "\n選択GARARI=" (itoa count) " / 採用ユニーク累計=" (itoa (length records)) " / 除外要素=" (itoa excluded)))
    (setq retry nil)
    (if (= count 0)
      (progn
        (princ "\n対象GARARIがありません。")
        (initget "Retry Skip Exit") (setq value (getkword "\n[Retry(再選択)/Skip(0台として次へ)/Exit(終了)] <Retry>："))
        (cond ((= value "Exit") (garari:fail "選択終了（Excel未変更）")) ((= value "Skip") nil) (T (setq retry T))))))
  (list records seen excluded))
;; Project path persists separately from the tool repository search path pa-path.
(defun c:GARARIPROJECTSET (/ shell folder item path)
  (setq shell (vlax-create-object "Shell.Application"))
  (setq folder (vlax-invoke-method shell 'BrowseForFolder 0 "プロジェクトExcelの初期フォルダ" 1))
  (if folder
    (progn (setq item (vlax-get-property folder 'Self) path (vlax-get-property item 'Path))
      (if (vl-file-directory-p path) (progn (setenv "GARARI_PROJECT_DIR" path) (princ (strcat "\nprojectフォルダ：" path))))
      (vlax-release-object item) (vlax-release-object folder)))
  (vlax-release-object shell) (princ))
(defun garari:project-book (/ dir path)
  (setq dir (getenv "GARARI_PROJECT_DIR"))
  (if (and (or (null dir) (not (vl-file-directory-p dir)))
    (boundp 'PROJECT_DIR) (= (type PROJECT_DIR) 'STR) (vl-file-directory-p PROJECT_DIR))
    (progn (setq dir PROJECT_DIR) (setenv "GARARI_PROJECT_DIR" dir)))
  (if (or (null dir) (not (vl-file-directory-p dir)))
    (progn (princ "\nprojectフォルダが未設定または存在しません。フォルダを選択してください。")
      (c:GARARIPROJECTSET) (setq dir (getenv "GARARI_PROJECT_DIR"))))
  (if (and dir (vl-file-directory-p dir))
    (progn
      (setq path (getfiled "更新する既存プロジェクトExcelを選択" (strcat (vl-string-right-trim "/\\" dir) "\\") "xlsx" 0))
      (if (and path (/= (strcase (vl-filename-extension path)) ".XLSX")) (garari:fail "初期対応は.xlsxのみです。"))
      (if (and path (not (findfile path))) (garari:fail "対象Excelが存在しません。")) path)))
(defun garari:backup-path (path / base candidate n)
  (setq base (strcat (vl-filename-directory path) "/" (vl-filename-base path) "_GARARI_backup-"
    (vl-string-translate "." "_" (rtos (getvar "CDATE") 2 8))) candidate (strcat base ".xlsx") n 0)
  (while (findfile candidate) (setq n (1+ n) candidate (strcat base "-" (itoa n) ".xlsx"))) candidate)
;; Use the Windows Unicode copy API through FSO for OneDrive/reparse-point files.
;; Copy the saved bytes, not SaveCopyAs (which can reserialize the workbook).
;; Never overwrite a previous backup; release FSO even when CopyFile fails.
(defun garari:copy-backup-file (path backup / fso result size)
  (setq garari:backup-error nil
    path (vl-string-translate "/" "\\" path)
    backup (vl-string-translate "/" "\\" backup)
    fso (vl-catch-all-apply 'vlax-create-object (list "Scripting.FileSystemObject")))
  (if (vl-catch-all-error-p fso)
    (progn (setq garari:backup-error (vl-catch-all-error-message fso)) nil)
    (progn
      (setq result (vl-catch-all-apply 'vlax-invoke-method (list fso 'CopyFile path backup :vlax-false)))
      (vlax-release-object fso)
      (cond
        ((vl-catch-all-error-p result)
          (setq garari:backup-error (vl-catch-all-error-message result)) nil)
        ((not (and (setq size (vl-file-size path)) (> size 0) (= size (vl-file-size backup))))
          (setq garari:backup-error "コピー後のファイルサイズが一致しません。") nil)
        (T T)))))
(defun garari:copy-backup (path backup) (garari:copy-backup-file path backup))
;; Destination tuple: existing sheet, sheet name, owned name, rectangle, data.
;; A named rectangle is a user-assigned capacity, never an inferred UsedRange.
(defun garari:destination (sheets sheetname key data / sheet named area addr nr nc rows cols parent result areas)
  (setq sheet (vl-catch-all-apply 'vlax-get-property (list sheets 'Item sheetname))
    nr (length data) nc (length (car data)))
  (if (vl-catch-all-error-p sheet) (setq sheet nil) (setq sheet (garari:own sheet)))
  (setq named (if sheet (vl-catch-all-apply 'vlax-get-property (list sheet 'Range key))))
  (if (and named (not (vl-catch-all-error-p named)))
    (progn
      (setq area (garari:own named)
        parent (garari:own (vlax-get-property area 'Worksheet)))
      (if (/= (vla-get-Name parent) sheetname) (garari:fail "管理範囲のシートが設定と異なります。Excelの名前定義を修正してください。"))
      (setq addr (garari:address area))))
  (if (not addr)
    (if sheet
      (progn
        (princ (strcat "\n" sheetname "：管理範囲が未設定です。既存レイアウトの書込開始セルから管理する矩形を指定してください。"))
        (setq addr (getstring T (strcat "\n管理範囲（例 A5:" (garari:col nc) (itoa (+ nr 4)) "、Enterで中止）：")))
        (if (= addr "") (garari:fail "キャンセル（Excel未変更）"))
        (if (not (garari:rectangle-p addr)) (garari:fail "管理範囲はA1形式の単一矩形で指定してください。"))
        (setq result (vl-catch-all-apply 'vlax-get-property (list sheet 'Range addr)))
        (if (vl-catch-all-error-p result) (garari:fail "管理範囲が不正です。"))
        (setq area (garari:own result)))
      (setq addr (strcat "$A$1:$" (garari:col nc) "$" (itoa (max 200 nr))))))
  (if area
    (progn
      (setq areas (garari:own (vlax-get-property area 'Areas)))
      (if (/= (vlax-get-property areas 'Count) 1) (garari:fail "管理範囲は単一矩形にしてください。"))
      (garari:drop areas)
      (setq rows (garari:own (vlax-get-property area 'Rows)) cols (garari:own (vlax-get-property area 'Columns)))
      (if (or (< (vlax-get-property rows 'Count) nr) (< (vlax-get-property cols 'Count) nc))
        (garari:fail (strcat sheetname "：管理範囲が不足しています。名前定義 " key " を拡張して再実行してください。")))
      ;; Preflight rejects merges touching data on another side of the boundary.
      (garari:check-merges area)
      (if (= (vlax-get-property sheet 'ProtectContents) :vlax-true) (garari:fail "対象シートが保護されています。"))))
  (list sheet sheetname key addr data))
(defun garari:cell-p (s / i letters digits c)
  (setq i 1 letters "" digits "" s (vl-string-translate "$" " " (strcase s)) s (garari:compact s))
  (while (and (<= i (strlen s)) (>= (ascii (substr s i 1)) 65) (<= (ascii (substr s i 1)) 90))
    (setq letters (strcat letters (substr s i 1)) i (1+ i)))
  (setq digits (substr s i))
  (and (/= letters "") (<= (strlen letters) 3) (garari:digits digits) (> (atoi digits) 0) (<= (atoi digits) 1048576)))
(defun garari:rectangle-p (s / xs)
  (setq xs (garari:split s ":"))
  (and (= (length xs) 2) (garari:cell-p (car xs)) (garari:cell-p (cadr xs))))
(defun garari:check-merges (area / cells cell merged r c nr nc mr mc rr cc i seen addr indices j)
  (if (/= (vlax-get-property area 'MergeCells) :vlax-false) (progn
  (setq r (vlax-get-property area 'Row) c (vlax-get-property area 'Column)
    cells (garari:own (vlax-get-property area 'Cells))
    rr (garari:own (vlax-get-property area 'Rows)) cc (garari:own (vlax-get-property area 'Columns))
    nr (vlax-get-property rr 'Count) nc (vlax-get-property cc 'Count))
  (if (> (* nr nc) 500000) (garari:fail "管理範囲が大きすぎます（50万セル以内）。"))
  ;; Only perimeter cells can belong to a merge crossing the owned boundary.
  (setq i 1)
  (repeat nc (setq indices (cons i indices) indices (cons (+ (* (1- nr) nc) i) indices) i (1+ i)))
  (setq j 1)
  (repeat (max 0 (- nr 2))
    (setq indices (cons (1+ (* j nc)) indices) indices (cons (* (1+ j) nc) indices) j (1+ j)))
  (foreach i indices
    (setq cell (garari:own (vlax-get-property cells 'Item i)))
    (if (= (vlax-get-property cell 'MergeCells) :vlax-true)
      (progn
        (setq merged (garari:own (vlax-get-property cell 'MergeArea)) addr (garari:address merged))
        (if (not (member addr seen))
          (progn
            (setq mr (garari:own (vlax-get-property merged 'Rows)) mc (garari:own (vlax-get-property merged 'Columns)))
            (if (or (< (vlax-get-property merged 'Row) r) (< (vlax-get-property merged 'Column) c)
              (> (+ (vlax-get-property merged 'Row) (vlax-get-property mr 'Count)) (+ r nr))
              (> (+ (vlax-get-property merged 'Column) (vlax-get-property mc 'Count)) (+ c nc)))
              (garari:fail "管理範囲の境界をまたぐ結合セルがあります。範囲を修正してください。"))
            (garari:drop mr) (garari:drop mc) (setq seen (cons addr seen))))
        (garari:drop merged)))
    (garari:drop cell))
  (garari:drop rr) (garari:drop cc) (garari:drop cells))))
(defun garari:write-destination (sheets target / sheet area data row col names name missing)
  (setq garari:stage (strcat "書込 " (cadr target) " / シート"))
  (setq sheet (car target) data (nth 4 target))
  (if (not sheet) (setq sheet (garari:sheet sheets (cadr target))))
  (setq garari:stage (strcat "書込 " (cadr target) " / 範囲"))
  (setq area (garari:own (vlax-get-property sheet 'Range (nth 3 target)))
    row (vlax-get-property area 'Row) col (vlax-get-property area 'Column))
  ;; Clear only the owned rectangle. Rebuild its internal merges from the new plan.
  (vlax-invoke-method area 'UnMerge)
  (vlax-invoke-method area 'ClearContents)
  (setq garari:stage (strcat "書込 " (cadr target) " / セル"))
  (garari:put-matrix-at sheet row col data)
  (setq names (garari:own (vlax-get-property garari:book 'Names)))
  (setq garari:stage (strcat "書込 " (cadr target) " / 名前定義"))
  (setq missing (vlax-make-variant))
  (setq name (garari:own (vlax-invoke-method names 'Add (nth 2 target)
    (strcat "='" (garari:escape-sheet (cadr target)) "'!" (garari:address area))
    :vlax-true missing missing missing missing missing missing missing missing)))
  (vlax-put-property name 'RefersTo
    (strcat "='" (garari:escape-sheet (cadr target)) "'!" (garari:address area)))
  (garari:drop name) (garari:drop names) (garari:drop area))
(defun garari:merge-table (sheet address blocks nc / area r c block col merged)
  (setq area (garari:own (vlax-get-property sheet 'Range address)) r (vlax-get-property area 'Row) c (vlax-get-property area 'Column))
  (foreach block blocks
    (setq col 1)
    (repeat nc
      (if (/= col 3)
        (progn (setq merged (garari:range sheet (+ r (car block) -1) (+ c col -1) (+ r (cadr block) -1) (+ c col -1)))
          (vlax-invoke-method merged 'Merge) (garari:drop merged)))
      (setq col (1+ col))))
  (garari:drop area))
(defun garari:address (area)
  (vlax-get-property area 'Address :vlax-true :vlax-true 1 :vlax-false (vlax-make-variant)))
(defun garari:escape-sheet (s / out c)
  (setq out "") (foreach c (vl-string->list s) (setq out (strcat out (if (= c 39) "''" (chr c))))) out)

(defun c:GARARITABLE (/ *error* garari:stage garari:objects garari:excel garari:book garari:handed garari:temp garari:saved garari:file garari:reason garari:issues
  cfg master rooms masters mp records groups floors requested excluded global path settings value mode floor selection seen r warnings warning-count error-count total)
  (defun *error* (msg)
    (princ (strcat "\nGARARITABLE：" (if garari:reason garari:reason msg)))
    (if garari:stage (princ (strcat "\n処理段階：" garari:stage)))
    (garari:cleanup)
    (if garari:saved (princ "\n対象Excelの保存は完了しています。再表示に失敗したため対象ファイルを確認してください。")) (princ))
  (princ (strcat "\nGARARITABLE version " garari:version " / backup: Windows FSO"))
  (if (= (getvar "LISPSYS") 0) (garari:fail "LISPSYS=1または2に設定しAutoCADを再起動してください。"))
  (while (null requested)
    (setq value (getstring T "\n対象階（1～4 / 1,3,4 / B1F,1F,RF）："))
    (if (= (garari:trim value) "") (garari:fail "キャンセル"))
    (setq requested (garari:parse-floors value))
    (if (null requested) (princ "\n階指定が不正です。昇順の整数範囲または階名を指定してください。")))
  (initget "Select Floor") (setq mode (getkword "\n割当方式 [Select(階別選択)/Floor(FLOOR属性)] <Select>："))
  (setq cfg garari:config excluded 0)
  (initget 6) (setq value (getint "\n案件FD温度 <72>：")) (if value (setq cfg (garari:set cfg 'fd-temp (itoa value))))
  (initget 6) (setq value (getint "\n案件防虫網メッシュ数 <10>：")) (if value (setq cfg (garari:set cfg 'mesh-spec (itoa value))))
  (initget "Yes No") (setq value (getkword "\nSOUNDタグ欠落時の防音指定 [Yes/No] <No>：")) (setq cfg (garari:set cfg 'sound (if (= value "Yes") "あり" "なし")))
  (setq mp (garari:master-path) masters (garari:read-masters mp) master (car masters) rooms (cadr masters) global garari:issues)
  (foreach floor (if (= mode "Floor") '("") requested)
    (setq selection (garari:selection floor master rooms cfg records seen requested)
      records (car selection) seen (cadr selection) excluded (+ excluded (caddr selection))))
  ;; Every assigned floor is represented, including invalid/missing/out-of-scope FLOOR values.
  (setq floors requested)
  (foreach floor (garari:floors records) (if (not (member floor floors)) (setq floors (append floors (list floor)))))
  (setq records (garari:cross-check records) groups (garari:aggregate records))
  (garari:summary records groups floors excluded)
  (setq total 0)
  (foreach floor floors (foreach r records (if (= floor (garari:get r "FLOOR")) (setq total (1+ total)))))
  (if (/= total (length records)) (garari:fail "階別数量合計と採用数が一致しません"))
  (setq warnings (length global))
  (foreach r records (setq warnings (+ warnings (length (garari:get r "ISSUES")))))
  (setq warning-count (garari:issue-count records global "警告") error-count (garari:issue-count records global "エラー"))
  (setq settings (list (list "集計日時" (rtos (getvar "CDATE") 2 6))
    (list "DWG" (strcat (getvar "DWGPREFIX") (getvar "DWGNAME")))
    (list "選択方式" (if (= mode "Floor") "FLOOR属性一括" "階別選択・FLOOR優先"))
    (list "指定階" (garari:join requested "/")) (list "出力階" (garari:join floors "/"))
    (list "統合マスター" mp) (list "マスターシート" "GARARI_MASTER / ROOM_MASTER")
    (list "FD_TEMP" (cdr (assoc 'fd-temp cfg))) (list "MESH_SPEC" (cdr (assoc 'mesh-spec cfg)))
    (list "SOUND既定" (cdr (assoc 'sound cfg))) (list "除外要素" excluded)
    (list "警告・エラー件数" warnings) (list "警告件数" warning-count) (list "エラー件数" error-count)
    (list "選定範囲" "参考型番。組合せ・施工適合要確認")))
  (if (not (setq path (garari:project-book))) (garari:fail "キャンセル（対象Excel未変更）"))
  (princ (strcat "\n更新対象：" path " / " (cdr (assoc 'table-sheet garari:config)) " / 採用=" (itoa (length records)) " / 警告=" (itoa warning-count) " / エラー=" (itoa error-count)))
  (garari:write-xlsx path records groups floors settings global)
  (princ (strcat "\nGARARITABLE 更新・保存完了：" path "\nシート：" (cdr (assoc 'table-sheet garari:config))
    " / 採用=" (itoa (length records)) " / 警告=" (itoa warning-count) " / エラー=" (itoa error-count)))
  (garari:cleanup) (princ))
(princ (strcat "\nGARARITABLE loaded. Version: " garari:version " / backup: Windows FSO"))
(princ "\nCommands: GARARITABLE / GARARIMASTERSET / GARARIPROJECTSET") (princ)
